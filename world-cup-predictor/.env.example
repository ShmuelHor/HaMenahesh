# football-data.org — free registration: https://www.football-data.org/client/register
FOOTBALL_API_KEY=

# Anthropic Claude API — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Telegram Bot — create a new bot via @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID — send a message to your bot, then open:
# https://api.telegram.org/bot<TOKEN>/getUpdates and find chat.id
# For a group chat the ID is negative (e.g. -100123456789)
TELEGRAM_CHAT_ID=

# Telegram Admin Chat ID — private chat for startup/health messages (your personal chat ID)
# Send /start to your bot in a private chat, then check getUpdates for the positive numeric ID
TELEGRAM_ADMIN_CHAT_ID=

# OpenWeatherMap — free tier: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Claude model to use for predictions
# claude-sonnet-4-6  — fast and cost-effective (default)
# claude-opus-4-8    — most capable, higher cost
CLAUDE_MODEL=claude-sonnet-4-6

# MongoDB URI — set automatically by docker-compose.yml, no need to change
# MONGO_URI=mongodb://mongo:27017/worldcup

# ── Cron schedules (cron syntax, Israel/Jerusalem timezone) ──────────────────
# Format: minute hour day-of-month month day-of-week
CRON_MORNING=0 8 * * *
CRON_NIGHT=0 23 * * *
CRON_WEEKLY=0 20 * * 0
CRON_POST_MATCH=*/30 * * * *
CRON_DAILY_HEALTH=0 9 * * *

# Minutes before kick-off to send the pre-match reminder
PRE_MATCH_REMINDER_MINUTES=30

# Run the morning job immediately on startup (for testing only — remove in production)
# RUN_MORNING_NOW=true
